{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": true,
        "color_scheme": "scheme-2"
      }
    },
    "search": {
      "type": "lustre-collection-search",
      "settings": {
        "placeholder": "Search products...",
        "button_label": "Search",
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 12
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "quick_add": "standard",
        "enable_filtering": true,
        "filter_type": "vertical",
        "enable_sorting": true,
        "padding_top": 24,
        "padding_bottom": 72
      }
    }
  },
  "order": [
    "banner",
    "search",
    "product-grid"
  ]
}
