<section
  class="lustre-product-tabs color-{{ section.settings.color_scheme }} gradient"
  style="--lustre-padding-top: {{ section.settings.padding_top }}px; --lustre-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-lustre-tabs
>
  <div class="page-width">
    <div class="lustre-product-tabs__nav" role="tablist" aria-label="Product information">
      <button
        type="button"
        class="is-active"
        role="tab"
        aria-selected="true"
        data-lustre-tab-button="description"
      >
        {{ section.settings.description_label }}
      </button>
      {%- for block in section.blocks -%}
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-lustre-tab-button="tab-{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.heading }}
        </button>
      {%- endfor -%}
    </div>

    <div class="lustre-product-tabs__panel rte is-active" role="tabpanel" data-lustre-tab-panel="description">
      {{ product.description }}
    </div>
    {%- for block in section.blocks -%}
      <div class="lustre-product-tabs__panel rte" role="tabpanel" data-lustre-tab-panel="tab-{{ block.id }}">
        {{ block.settings.content }}
        {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lustre product tabs",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "description_label",
      "label": "Description tab label",
      "default": "Description"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add care, material, delivery, or other useful product information here.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lustre product tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
