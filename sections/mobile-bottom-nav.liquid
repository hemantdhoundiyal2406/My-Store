{% comment %}
  Recommended mobile footer icon image size: 64 x 64 px.
{% endcomment %}

{%- liquid
  if section.settings.use_theme_mobile_nav_settings
    assign nav_enabled = settings.theme_mobile_nav_enabled
    assign nav_color_scheme = settings.theme_mobile_nav_color_scheme | default: section.settings.color_scheme
  else
    assign nav_enabled = section.settings.show_navigation
    assign nav_color_scheme = section.settings.color_scheme | default: settings.theme_mobile_nav_color_scheme
  endif
-%}

{%- if nav_enabled -%}
  <nav class="lustre-mobile-nav color-{{ nav_color_scheme }} gradient" style="--lustre-mobile-nav-columns: 5;" aria-label="Quick navigation">
    {%- for item_index in (1..5) -%}
      {%- liquid
        assign nav_role = blank
        assign nav_icon_svg = blank
        assign nav_icon_image = blank
        assign nav_label = blank
        assign nav_link = blank
        assign is_active = false

        case item_index
          when 1
            if section.settings.use_theme_mobile_nav_settings
              assign nav_role = settings.theme_mobile_nav_item_1_role | default: section.settings.item_1_role
              assign nav_icon_svg = settings.theme_mobile_nav_item_1_icon_svg | default: section.settings.item_1_icon_svg
              assign nav_icon_image = settings.theme_mobile_nav_item_1_icon_image | default: section.settings.item_1_icon_image
              assign nav_label = settings.theme_mobile_nav_item_1_label | default: section.settings.item_1_label
              assign nav_link = settings.theme_mobile_nav_item_1_link | default: section.settings.item_1_link
            else
              assign nav_role = section.settings.item_1_role | default: settings.theme_mobile_nav_item_1_role
              assign nav_icon_svg = section.settings.item_1_icon_svg | default: settings.theme_mobile_nav_item_1_icon_svg
              assign nav_icon_image = section.settings.item_1_icon_image | default: settings.theme_mobile_nav_item_1_icon_image
              assign nav_label = section.settings.item_1_label | default: settings.theme_mobile_nav_item_1_label
              assign nav_link = section.settings.item_1_link | default: settings.theme_mobile_nav_item_1_link
            endif
          when 2
            if section.settings.use_theme_mobile_nav_settings
              assign nav_role = settings.theme_mobile_nav_item_2_role | default: section.settings.item_2_role
              assign nav_icon_svg = settings.theme_mobile_nav_item_2_icon_svg | default: section.settings.item_2_icon_svg
              assign nav_icon_image = settings.theme_mobile_nav_item_2_icon_image | default: section.settings.item_2_icon_image
              assign nav_label = settings.theme_mobile_nav_item_2_label | default: section.settings.item_2_label
              assign nav_link = settings.theme_mobile_nav_item_2_link | default: section.settings.item_2_link
            else
              assign nav_role = section.settings.item_2_role | default: settings.theme_mobile_nav_item_2_role
              assign nav_icon_svg = section.settings.item_2_icon_svg | default: settings.theme_mobile_nav_item_2_icon_svg
              assign nav_icon_image = section.settings.item_2_icon_image | default: settings.theme_mobile_nav_item_2_icon_image
              assign nav_label = section.settings.item_2_label | default: settings.theme_mobile_nav_item_2_label
              assign nav_link = section.settings.item_2_link | default: settings.theme_mobile_nav_item_2_link
            endif
          when 3
            if section.settings.use_theme_mobile_nav_settings
              assign nav_role = settings.theme_mobile_nav_item_3_role | default: section.settings.item_3_role
              assign nav_icon_svg = settings.theme_mobile_nav_item_3_icon_svg | default: section.settings.item_3_icon_svg
              assign nav_icon_image = settings.theme_mobile_nav_item_3_icon_image | default: section.settings.item_3_icon_image
              assign nav_label = settings.theme_mobile_nav_item_3_label | default: section.settings.item_3_label
              assign nav_link = settings.theme_mobile_nav_item_3_link | default: section.settings.item_3_link
            else
              assign nav_role = section.settings.item_3_role | default: settings.theme_mobile_nav_item_3_role
              assign nav_icon_svg = section.settings.item_3_icon_svg | default: settings.theme_mobile_nav_item_3_icon_svg
              assign nav_icon_image = section.settings.item_3_icon_image | default: settings.theme_mobile_nav_item_3_icon_image
              assign nav_label = section.settings.item_3_label | default: settings.theme_mobile_nav_item_3_label
              assign nav_link = section.settings.item_3_link | default: settings.theme_mobile_nav_item_3_link
            endif
          when 4
            if section.settings.use_theme_mobile_nav_settings
              assign nav_role = settings.theme_mobile_nav_item_4_role | default: section.settings.item_4_role
              assign nav_icon_svg = settings.theme_mobile_nav_item_4_icon_svg | default: section.settings.item_4_icon_svg
              assign nav_icon_image = settings.theme_mobile_nav_item_4_icon_image | default: section.settings.item_4_icon_image
              assign nav_label = settings.theme_mobile_nav_item_4_label | default: section.settings.item_4_label
              assign nav_link = settings.theme_mobile_nav_item_4_link | default: section.settings.item_4_link
            else
              assign nav_role = section.settings.item_4_role | default: settings.theme_mobile_nav_item_4_role
              assign nav_icon_svg = section.settings.item_4_icon_svg | default: settings.theme_mobile_nav_item_4_icon_svg
              assign nav_icon_image = section.settings.item_4_icon_image | default: settings.theme_mobile_nav_item_4_icon_image
              assign nav_label = section.settings.item_4_label | default: settings.theme_mobile_nav_item_4_label
              assign nav_link = section.settings.item_4_link | default: settings.theme_mobile_nav_item_4_link
            endif
          when 5
            if section.settings.use_theme_mobile_nav_settings
              assign nav_role = settings.theme_mobile_nav_item_5_role | default: section.settings.item_5_role
              assign nav_icon_svg = settings.theme_mobile_nav_item_5_icon_svg | default: section.settings.item_5_icon_svg
              assign nav_icon_image = settings.theme_mobile_nav_item_5_icon_image | default: section.settings.item_5_icon_image
              assign nav_label = settings.theme_mobile_nav_item_5_label | default: section.settings.item_5_label
              assign nav_link = settings.theme_mobile_nav_item_5_link | default: section.settings.item_5_link
            else
              assign nav_role = section.settings.item_5_role | default: settings.theme_mobile_nav_item_5_role
              assign nav_icon_svg = section.settings.item_5_icon_svg | default: settings.theme_mobile_nav_item_5_icon_svg
              assign nav_icon_image = section.settings.item_5_icon_image | default: settings.theme_mobile_nav_item_5_icon_image
              assign nav_label = section.settings.item_5_label | default: settings.theme_mobile_nav_item_5_label
              assign nav_link = section.settings.item_5_link | default: settings.theme_mobile_nav_item_5_link
            endif
        endcase

        if nav_label == blank
          case nav_role
            when 'home'
              assign nav_label = 'Home'
            when 'search'
              assign nav_label = 'Search'
            when 'collections'
              assign nav_label = 'Collections'
            when 'account'
              assign nav_label = 'Account'
            when 'cart'
              assign nav_label = 'Cart'
          endcase
        endif

        case nav_role
          when 'home'
            if nav_link == blank
              assign nav_link = routes.root_url
            endif
            if request.page_type == 'index'
              assign is_active = true
            endif
          when 'search'
            if nav_link == blank
              assign nav_link = routes.search_url
            endif
            if request.page_type == 'search'
              assign is_active = true
            endif
          when 'collections'
            if nav_link == blank
              assign nav_link = routes.all_products_collection_url
            endif
            if request.page_type == 'collection' or request.page_type == 'list-collections'
              assign is_active = true
            endif
          when 'account'
            if nav_link == blank
              if shop.customer_accounts_enabled
                if customer
                  assign nav_link = routes.account_url
                else
                  assign nav_link = routes.account_login_url
                endif
              else
                assign nav_link = routes.root_url
              endif
            endif
            if request.page_type contains 'customers'
              assign is_active = true
            endif
          when 'cart'
            if nav_link == blank
              assign nav_link = routes.cart_url
            endif
            if request.page_type == 'cart'
              assign is_active = true
            endif
          else
            if nav_link == blank
              assign nav_link = routes.root_url
            endif
            if request.path == nav_link
              assign is_active = true
            endif
        endcase
      -%}

      {%- if nav_label != blank -%}
        <a href="{{ nav_link }}" class="{% if is_active %}is-active{% endif %}" {% if is_active %}aria-current="page"{% endif %}>
          <span class="lustre-mobile-nav__icon-wrapper">
            {%- if nav_icon_image != blank -%}
              {{
                nav_icon_image
                | image_url: width: 64
                | image_tag:
                  class: 'lustre-mobile-nav__icon-image',
                  widths: '32, 48, 64',
                  sizes: '32px',
                  alt: nav_label
              }}
            {%- else -%}
              {% render 'lustre-icon', name: nav_icon_svg, size: 21 %}
            {%- endif -%}

            {%- if nav_role == 'cart' and cart.item_count > 0 -%}
              <b>{{ cart.item_count }}</b>
            {%- endif -%}
          </span>
          <span>{{ nav_label }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
{%- endif -%}

