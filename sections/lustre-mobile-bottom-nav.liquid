{% comment %}
  Recommended mobile footer icon image size: 64 x 64 px.
  Add or edit nav items from the Shopify customizer in the Lustre mobile navigation section.
{% endcomment %}

{%- if section.settings.show_navigation and section.blocks.size > 0 -%}
  <nav
    class="lustre-mobile-nav color-{{ section.settings.color_scheme }} gradient"
    style="--lustre-mobile-nav-columns: {{ section.blocks.size }};"
    aria-label="Quick navigation"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign nav_role = block.settings.nav_role
        assign nav_link = block.settings.link
        assign is_active = false

        case nav_role
          when 'home'
            if nav_link == blank
              assign nav_link = routes.root_url
            endif
            if request.page_type == 'index'
              assign is_active = true
            endif
          when 'search'
            if nav_link == blank
              assign nav_link = routes.search_url
            endif
            if request.page_type == 'search'
              assign is_active = true
            endif
          when 'collections'
            if nav_link == blank
              assign nav_link = routes.all_products_collection_url
            endif
            if request.page_type == 'collection' or request.page_type == 'list-collections'
              assign is_active = true
            endif
          when 'account'
            if nav_link == blank
              if shop.customer_accounts_enabled
                if customer
                  assign nav_link = routes.account_url
                else
                  assign nav_link = routes.account_login_url
                endif
              else
                assign nav_link = routes.root_url
              endif
            endif
            if request.page_type contains 'customers'
              assign is_active = true
            endif
          when 'cart'
            if nav_link == blank
              assign nav_link = routes.cart_url
            endif
            if request.page_type == 'cart'
              assign is_active = true
            endif
          else
            if nav_link == blank
              assign nav_link = routes.root_url
            endif
            if request.path == nav_link
              assign is_active = true
            endif
        endcase
      -%}
      <a
        href="{{ nav_link }}"
        class="{% if is_active %}is-active{% endif %}"
        {% if is_active %}aria-current="page"{% endif %}
        {{ block.shopify_attributes }}
      >
        <span class="lustre-mobile-nav__icon-wrapper">
          {%- if block.settings.icon_image != blank -%}
            {{
              block.settings.icon_image
              | image_url: width: 64
              | image_tag:
                class: 'lustre-mobile-nav__icon-image',
                widths: '32, 48, 64',
                sizes: '32px',
                alt: block.settings.label
            }}
          {%- else -%}
            {% render 'lustre-icon', name: block.settings.icon_svg, size: 21 %}
          {%- endif -%}

          {%- if nav_role == 'cart' and cart.item_count > 0 -%}
            <b>{{ cart.item_count }}</b>
          {%- endif -%}
        </span>
        <span>{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Lustre mobile navigation",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Enable mobile bottom navbar",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Nav item",
      "settings": [
        {
          "type": "select",
          "id": "nav_role",
          "label": "Navigation type",
          "default": "home",
          "options": [
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "search",
              "label": "Search"
            },
            {
              "value": "collections",
              "label": "Collections"
            },
            {
              "value": "account",
              "label": "Account"
            },
            {
              "value": "cart",
              "label": "Cart"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ]
        },
        {
          "type": "select",
          "id": "icon_svg",
          "label": "SVG icon",
          "default": "home",
          "options": [
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "search",
              "label": "Search"
            },
            {
              "value": "grid",
              "label": "Collections"
            },
            {
              "value": "user",
              "label": "Account"
            },
            {
              "value": "cart",
              "label": "Cart"
            },
            {
              "value": "heart",
              "label": "Wishlist"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "truck",
              "label": "Shipping"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Recommended size: 64 x 64 px. If uploaded, this image replaces the SVG icon."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Home"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Navigation link",
          "info": "Leave blank to use the default route for the selected navigation type."
        }
      ]
    }
  ]
}
{% endschema %}
